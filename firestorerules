rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isViewer() {
      return isAuthenticated() && request.auth.token.role == 'viewer';
    }

    function isAnyUser() {
      return isAdmin() || isViewer();
    }

    // Admin: CRUD. Viewer: read only.
    function allowAdminWrite() { return isAdmin(); }

    // ==========================================
    // ANALYTICS DATA (Dashboard Analytics tab)
    // Viewer read-only, admin CRUD.
    // GAS sync uses REST API (bypasses rules),
    // so restricting client write to admin is safe.
    // ==========================================

    match /customers/{cif} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }

    match /metrics/{cif} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }

    match /groups/{group} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }

    match /insights/{cif} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }

    match /customerInfo/{cif} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }

    // ==========================================
    // USER-FACING COLLECTIONS
    // Viewer full CRUD (Commitment Calendar)
    // ==========================================

    match /commitments/{doc} {
      allow read:   if isAnyUser();
      allow create: if isAnyUser();
      allow update: if isAnyUser();
      allow delete: if isAnyUser();
    }

    // GPS entries — viewer full CRUD
    match /gpsEntries/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAnyUser();
      allow update: if isAnyUser();
      allow delete: if isAnyUser();
    }

    // ==========================================
    // ADMIN-ONLY MANAGEMENT
    // ==========================================

    // Roles — prevent viewer privilege escalation
    match /roles/{userId} {
      allow read:   if isAnyUser();
      allow write:  if allowAdminWrite();
    }

    // Users — admin creates via Identity Toolkit,
    // then writes user doc. Viewer read-only.
    match /Users/{uid} {
      allow read:   if isAnyUser();
      allow create: if allowAdminWrite();
      allow update: if allowAdminWrite();
      allow delete: if allowAdminWrite();
    }
  }
}
