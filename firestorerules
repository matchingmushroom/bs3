rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    //
    // Roles are read from the Firestore `roles/{uid}` document
    // instead of custom claims, so no Admin SDK / Blaze plan needed.
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    function isViewer() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'viewer';
    }

    function isAnyUser() {
      return isAdmin() || isViewer();
    }

    // ==========================================
    // ANALYTICS DATA — viewer read-only, admin CRUD
    // ==========================================
    match /customers/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /metrics/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /groups/{group} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /insights/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customerInfo/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // USER-FACING COLLECTIONS — viewer full CRUD
    // ==========================================
    match /commitments/{doc} {
      allow read:   if isAnyUser();
      allow create: if isAnyUser();
      allow update: if isAnyUser();
      allow delete: if isAnyUser();
    }

    match /gpsEntries/{cif} {
      allow read:   if isAnyUser();
      allow create: if isAnyUser();
      allow update: if isAnyUser();
      allow delete: if isAnyUser();
    }

    // ==========================================
    // ADMIN-ONLY MANAGEMENT
    // ==========================================

    // Roles — admin only write to prevent escalation
    match /roles/{userId} {
      allow read:   if isAnyUser();
      allow write:  if isAdmin();
    }

    // Users — admin CRUD
    match /Users/{uid} {
      allow read:   if isAnyUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
